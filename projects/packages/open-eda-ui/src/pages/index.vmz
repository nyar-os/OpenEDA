<template>
    <div class="studio">
        <header class="winbar">
            <div class="winbar__brand" data-drag="true">
                <span class="winbar__mark">E</span>
                <span class="winbar__name">OpenEDA Studio</span>
                <span class="winbar__divider"></span>
                <span class="winbar__doc" :title="pathLine()">{{ designTitle() }}</span>
            </div>
            <div class="winbar__commands">
                <div class="winbar__group">
                    <span class="winbar__label">File</span>
                    <div class="winbar__row">
                        <button type="button" class="winbar__btn" :disabled="!hostReady" title="New design (Ctrl/Cmd+N)" @click="newDesign">New</button>
                        <button type="button" class="winbar__btn" :disabled="!hostReady" title="Open design (Ctrl/Cmd+O)" @click="openDesign">Open</button>
                        <button type="button" class="winbar__btn" :disabled="!hostReady" title="Save design (Ctrl/Cmd+S)" @click="saveDesign">Save</button>
                        <button type="button" :class="exportOpen ? 'winbar__btn winbar__btn--on' : 'winbar__btn'" :disabled="!hostReady || !design || !capabilities" :title="exportTitle()" @click="toggleExport">Export</button>
                    </div>
                </div>
                <div class="winbar__group winbar__group--doc">
                    <span class="winbar__label">Doc</span>
                    <div class="winbar__row">
                        <button type="button" class="winbar__btn" :disabled="!hostReady || !design || !design.canUndo" title="Undo (Ctrl/Cmd+Z)" @click="undoEdit">Undo</button>
                        <button type="button" class="winbar__btn" :disabled="!hostReady || !design || !design.canRedo" title="Redo (Ctrl/Cmd+Shift+Z or Ctrl+Y)" @click="redoEdit">Redo</button>
                        <button type="button" class="winbar__btn" :disabled="!hostReady || !design" title="Close design (Ctrl/Cmd+W)" @click="closeDesign">Close design</button>
                    </div>
                </div>
                <div class="winbar__group winbar__group--view">
                    <span class="winbar__label">View</span>
                    <div class="winbar__row">
                        <button type="button" class="winbar__btn" disabled title="Viewport renderer is not implemented">Fit</button>
                        <button type="button" class="winbar__btn" disabled title="Viewport renderer is not implemented">Zoom out</button>
                        <span class="winbar__zoom">100%</span>
                        <button type="button" class="winbar__btn" disabled title="Viewport renderer is not implemented">Zoom in</button>
                    </div>
                </div>
            </div>
            <div class="winbar__spacer" data-drag="true"></div>
            <div class="winbar__end">
                <span class="winbar__status">
                    <span :class="hostReady ? 'winbar__led' : 'winbar__led winbar__led--idle'"></span>
                    <span class="winbar__mode">{{ modeLabel() }}</span>
                </span>
                <button type="button" class="winbar__btn winbar__btn--icon" title="Keyboard shortcuts" aria-haspopup="dialog" :aria-expanded="shortcutsOpen ? 'true' : 'false'" @click="toggleShortcuts">?</button>
                <div class="winbar__controls" v-if="customChrome">
                    <button type="button" class="winbar__ctl" aria-label="Minimize" title="Minimize" @click="windowMinimize">
                        <svg class="winbar__icon" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true">
                            <path d="M1 5h8" fill="none" stroke="currentColor" stroke-width="1" />
                        </svg>
                    </button>
                    <button type="button" class="winbar__ctl" aria-label="Maximize" title="Maximize" @click="windowToggleMaximize">
                        <svg class="winbar__icon" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true">
                            <rect x="1" y="1" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1" />
                        </svg>
                    </button>
                    <button type="button" class="winbar__ctl winbar__ctl--close" aria-label="Close window" title="Close" @click="windowClose">
                        <svg class="winbar__icon" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true">
                            <path d="M1.5 1.5l7 7M8.5 1.5l-7 7" fill="none" stroke="currentColor" stroke-width="1" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="export-panel" v-if="exportOpen">
                <div class="export-panel__head">
                    <b>Export projection</b>
                    <span :class="exportBadgeClass()">{{ exportBadgeLabel() }}</span>
                </div>
                <label class="field">
                    <span class="field__label">Format</span>
                    <select class="input" :value="exportFormat" @change="onExportFormat">
                        <option v-for="target in exportTargetRows()" :key="target.name" :value="target.name" :disabled="!target.supported">{{ target.name }}</option>
                    </select>
                </label>
                <div class="field">
                    <span class="field__label">Target</span>
                    <p class="readout mono">{{ exportTargetReadout() }}</p>
                </div>
                <p class="note" v-if="!design">Open a design before projecting an export target.</p>
                <p class="note" v-else>{{ exportNote() }}</p>
                <div class="export-panel__actions">
                    <button type="button" class="btn btn--strong" :disabled="!canExport()" @click="exportCurrent">Export</button>
                    <button type="button" class="btn" @click="closeExport">Cancel</button>
                </div>
            </div>

            <div class="shortcuts" v-if="shortcutsOpen" role="dialog" aria-label="Keyboard shortcuts">
                <div class="shortcuts__head">
                    <b>Keyboard shortcuts</b>
                    <button type="button" class="btn btn--small" @click="toggleShortcuts">Close</button>
                </div>
                <dl class="shortcuts__list">
                    <div class="shortcut" v-for="item in shortcutList()" :key="item.label">
                        <dt>{{ item.label }}</dt>
                        <dd>{{ item.keys }}</dd>
                    </div>
                </dl>
            </div>
        </header>

        <section class="context">
            <label class="path-field">
                <span class="path-field__label">Path</span>
                <input class="input input--path" :value="path" placeholder="C:\designs\blinker.oeda" spellcheck="false" aria-label="Design path" @input="onPathInput" />
            </label>
            <p class="context__hint">Type a path; the native file picker is not implemented.</p>
            <div class="context__pills">
                <span :class="revisionChipClass()">{{ revisionLabel() }}</span>
                <span class="pill">{{ hostPillLabel() }}</span>
                <span :class="enginePillClass()">
                    <span class="dot" v-if="engineReported()"></span>
                    <span class="dot dot--idle" v-else></span>
                    {{ engineLabel() }}
                </span>
            </div>
        </section>

        <div class="banner" v-if="!hostReady">
            <b>Preview mode.</b>
            The native WebView host is not attached, so no design can be created or opened.
        </div>

        <div class="workspace">
            <aside class="sidebar">
                <section class="panel">
                    <div class="panel__head"><h2>Document</h2></div>
                    <dl class="facts" v-if="design">
                        <dt>Title</dt>
                        <dd>{{ design.title || "Untitled design" }}</dd>
                        <dt>Id</dt>
                        <dd class="mono">{{ design.id }}</dd>
                        <dt>Revision</dt>
                        <dd class="mono">{{ design.revision }}</dd>
                        <dt>Path</dt>
                        <dd class="mono ellipsis" :title="pathLine()">{{ pathLine() }}</dd>
                        <dt>Sheets</dt>
                        <dd class="mono">{{ design.sheets.length }}</dd>
                        <dt>Objects</dt>
                        <dd class="mono">{{ totalObjects() }}</dd>
                    </dl>
                    <p class="empty" v-else>Nothing is open. A design arrives only from the host.</p>
                </section>

                <section class="panel">
                    <div class="panel__head">
                        <h2>Sheets</h2>
                        <span class="panel__count">{{ sheetCountLabel() }}</span>
                    </div>
                    <div class="sheet-actions">
                        <button type="button" class="btn btn--small" :disabled="!handle" title="Add an empty sheet" @click="beginAddSheet">Add</button>
                        <button type="button" class="btn btn--small" :disabled="!handle || !currentSheetId" title="Rename the selected sheet" @click="beginRenameSheet">Rename</button>
                        <button type="button" class="btn btn--small" :disabled="!handle || !currentSheetId" title="Delete the selected sheet when it is empty" @click="deleteSelectedSheet">Delete</button>
                    </div>
                    <div class="sheet-form" v-if="sheetEditing">
                        <input
                            class="input"
                            :value="sheetDraft"
                            :placeholder="sheetEditing === 'add' ? 'New sheet name' : 'Sheet name'"
                            aria-label="Sheet name"
                            data-sheet-draft="true"
                            @input="onSheetDraftInput"
                        />
                        <button type="button" class="btn btn--small btn--strong" :disabled="!sheetDraft.trim()" @click="submitSheetEdit">Save</button>
                        <button type="button" class="btn btn--small" @click="cancelSheetEdit">Cancel</button>
                    </div>
                    <div class="sheets" v-if="design && design.sheets.length">
                        <button
                            type="button"
                            v-for="sheet in design.sheets"
                            :key="sheet.id"
                            :class="sheet.id === currentSheetId ? 'sheet sheet--active' : 'sheet'"
                            :data-sheet-id="sheet.id"
                            @click="selectSheet"
                        >
                            <span class="sheet__index">{{ sheet.index + 1 }}</span>
                            <span class="sheet__body">
                                <span class="sheet__title">{{ sheet.name }}</span>
                                <span class="sheet__meta">{{ sheet.id }} · {{ sheet.objects }} objects</span>
                            </span>
                        </button>
                    </div>
                    <p class="empty" v-else>No sheets in this design.</p>
                </section>

                <section class="panel">
                    <div class="panel__head">
                        <h2>Objects</h2>
                        <span class="panel__count">{{ objectCountLabel() }}</span>
                    </div>
                    <div class="targets" v-if="objects && objects.components.length">
                        <div class="target" v-for="component in objects.components" :key="component.id">
                            <span class="target__name mono">{{ component.ref }} · {{ component.value || "no value" }}</span>
                            <span class="target__state">{{ component.pins.length }} pins</span>
                        </div>
                    </div>
                    <p class="empty" v-else>No components placed.</p>
                    <div class="targets" v-if="objects && objects.nets.length">
                        <div class="target" v-for="net in objects.nets" :key="net.id">
                            <span class="target__name mono">{{ net.name }}</span>
                            <span class="target__state">{{ net.nodes.length }} nodes</span>
                        </div>
                    </div>
                    <p class="empty" v-else>No nets declared.</p>
                </section>

                <section class="panel">
                    <div class="panel__head"><h2>Export targets</h2></div>
                    <div class="targets" v-if="capabilities">
                        <div class="target" v-for="row in exportTargetRows()" :key="row.name">
                            <span :class="row.dot"></span>
                            <span class="target__name mono">{{ row.name }}</span>
                            <span class="target__state">{{ row.status }}</span>
                        </div>
                    </div>
                    <p class="empty" v-else>Targets are declared by the capability matrix.</p>
                    <p class="note" v-if="capabilities && supportedTargetCount() === 0">Declared targets; none are supported by this build.</p>
                </section>
            </aside>

            <main class="canvas">
                <div class="canvas__bar">
                    <span class="canvas__title">Canvas</span>
                    <span class="canvas__zoom">zoom 100%</span>
                    <span class="chip chip--warn">renderer offline</span>
                </div>
                <div class="rulers">
                    <div class="ruler-corner"></div>
                    <div class="ruler ruler--h">
                        <span class="ruler__tick" v-for="tick in rulerTicks()" :key="'h' + tick.value" :class="{ 'ruler__tick--last': tick.last }">
                            <span class="ruler__label">{{ tick.value }}</span>
                        </span>
                    </div>
                    <div class="ruler ruler--v">
                        <span class="ruler__tick" v-for="tick in rulerTicks()" :key="'v' + tick.value" :class="{ 'ruler__tick--last': tick.last }">
                            <span class="ruler__label">{{ tick.value }}</span>
                        </span>
                    </div>
                    <div class="surface">
                        <div class="artboard" v-if="design">
                            <span class="artboard__eyebrow">Artboard</span>
                            <b class="artboard__title">{{ design.title || "Untitled design" }}</b>
                            <span class="artboard__id mono">{{ design.id }}</span>
                            <div class="artboard__facts">
                                <span>revision {{ design.revision }}</span>
                                <span>{{ design.sheets.length }} sheets</span>
                                <span>{{ totalObjects() }} objects</span>
                            </div>
                            <p class="artboard__note">The viewport renderer is not implemented, so no geometry is painted.</p>
                        </div>
                        <div class="empty-state" v-else>
                            <span class="empty-state__mark">E</span>
                            <b class="empty-state__title">No design open</b>
                            <p class="empty-state__hint">Create a design or open one at a path. The canvas stays empty until the renderer exists.</p>
                            <div class="empty-state__actions">
                                <button type="button" class="btn btn--strong" :disabled="!hostReady" @click="newDesign">New design</button>
                                <button type="button" class="btn" :disabled="!hostReady" @click="openDesign">Open path</button>
                            </div>
                        </div>
                        <div class="tools">
                            <span class="tools__label">Tools</span>
                            <button type="button" class="tool" disabled title="Not implemented">Select</button>
                            <button type="button" class="tool" disabled title="Not implemented">Pan</button>
                            <button type="button" class="tool" disabled title="Not implemented">Zoom</button>
                            <button type="button" class="tool" disabled title="Not implemented">Measure</button>
                            <span class="tools__badge">capability/not-implemented</span>
                        </div>
                    </div>
                </div>
            </main>

            <aside class="inspector">
                <div class="tabs" role="tablist" aria-label="Inspector">
                    <button type="button" role="tab" :class="tab === 'properties' ? 'tab tab--active' : 'tab'" :aria-selected="tab === 'properties' ? 'true' : 'false'" data-tab="properties" @click="selectTab">Properties</button>
                    <button type="button" role="tab" :class="tab === 'capabilities' ? 'tab tab--active' : 'tab'" :aria-selected="tab === 'capabilities' ? 'true' : 'false'" data-tab="capabilities" @click="selectTab">Capabilities</button>
                    <button type="button" role="tab" :class="tab === 'diagnostics' ? 'tab tab--active' : 'tab'" :aria-selected="tab === 'diagnostics' ? 'true' : 'false'" data-tab="diagnostics" @click="selectTab">Diagnostics</button>
                </div>

                <div class="tab-panel" v-if="tab === 'properties'">
                    <section class="card">
                        <h2 class="card__title">Design</h2>
                        <dl class="facts" v-if="design">
                            <dt>Title</dt>
                            <dd>{{ design.title || "Untitled design" }}</dd>
                            <dt>Id</dt>
                            <dd class="mono">{{ design.id }}</dd>
                            <dt>Revision</dt>
                            <dd class="mono">{{ design.revision }}</dd>
                            <dt>Sheets</dt>
                            <dd class="mono">{{ design.sheets.length }}</dd>
                            <dt>Objects</dt>
                            <dd class="mono">{{ totalObjects() }}</dd>
                        </dl>
                        <p class="empty" v-else>No design is open, so there are no facts to show.</p>
                    </section>
                    <section class="card">
                        <h2 class="card__title">Selection</h2>
                        <p class="note">No selection. Selection needs the viewport renderer.</p>
                    </section>
                    <section class="card">
                        <h2 class="card__title">Inspection</h2>
                        <button type="button" class="btn btn--wide" :disabled="!handle" title="Run the supported rule checks" @click="inspectDesign">Run inspection</button>
                        <p class="note">{{ inspectText() }}</p>
                        <ul class="issues" v-if="inspectResult && inspectResult.issues.length">
                            <li class="issue" v-for="issue in inspectResult.issues" :key="issue.objectId + ':' + issue.code">
                                <span :class="issueTone(issue)">{{ issue.severity }}</span>
                                <span class="issue__code mono">{{ issue.code }}</span>
                                <span class="issue__message">{{ issue.message }}</span>
                            </li>
                        </ul>
                    </section>
                </div>

                <div class="tab-panel" v-if="tab === 'capabilities'">
                    <section class="card" v-if="capabilities">
                        <h2 class="card__title">Engine</h2>
                        <dl class="facts">
                            <dt>Package</dt>
                            <dd class="mono">{{ capabilities.engine.package }}</dd>
                            <dt>Version</dt>
                            <dd class="mono">{{ capabilities.engine.version }}</dd>
                            <dt>Project</dt>
                            <dd>{{ projectSummary() }}</dd>
                        </dl>
                    </section>
                    <div class="cap-list" v-if="capabilities">
                        <div class="cap-row" v-for="row in capabilityRows()" :key="row.key">
                            <span class="cap-row__label">{{ row.label }}</span>
                            <span class="cap-row__value mono">{{ row.value }}</span>
                            <span :class="row.tone">{{ row.status }}</span>
                        </div>
                    </div>
                    <section class="card" v-if="capabilities">
                        <h2 class="card__title">Checks</h2>
                        <div class="targets">
                            <div class="target" v-for="row in checkRows()" :key="row.name">
                                <span :class="row.dot"></span>
                                <span class="target__name mono">{{ row.name }}</span>
                                <span class="target__state">{{ row.status }}</span>
                            </div>
                        </div>
                        <p class="note">Checks marked unsupported reject with capability/not-implemented.</p>
                    </section>
                    <section class="card" v-else>
                        <h2 class="card__title">Capabilities</h2>
                        <p class="note">The capability matrix loads once the native host answers. Nothing is assumed in the meantime.</p>
                    </section>
                    <p class="note" v-if="capabilities">{{ capabilityNote() }}</p>
                </div>

                <div class="tab-panel" v-if="tab === 'diagnostics'">
                    <section class="card">
                        <h2 class="card__title">Session</h2>
                        <dl class="facts">
                            <dt>Host</dt>
                            <dd>{{ hostLabel() }}</dd>
                            <dt>Connection</dt>
                            <dd>{{ connectionLabel() }}</dd>
                            <dt>Requests</dt>
                            <dd class="mono">{{ requestsSent }}</dd>
                            <dt>Revision</dt>
                            <dd class="mono">{{ design ? design.revision : "none" }}</dd>
                            <dt>History</dt>
                            <dd class="mono">{{ historyLabel() }}</dd>
                            <dt>Last request</dt>
                            <dd class="mono">{{ lastRequestLabel() }}</dd>
                            <dt>Last error</dt>
                            <dd class="mono">{{ lastErrorLabel() }}</dd>
                        </dl>
                        <p class="note mono" v-if="lastErrorText">{{ lastErrorText }}</p>
                    </section>
                    <section class="card">
                        <div class="card__head">
                            <h2 class="card__title">Recent requests</h2>
                            <div class="card__actions">
                                <button type="button" class="btn btn--small" @click="copyDiagnostics">Copy</button>
                                <button type="button" class="btn btn--small" @click="clearDiagnostics">Clear</button>
                            </div>
                        </div>
                        <div class="log" v-if="log.length">
                            <div class="log__row" v-for="entry in log" :key="entry.key">
                                <span class="log__time">{{ entry.time }}</span>
                                <span class="log__type">{{ entry.type }}</span>
                                <span :class="entry.tone">{{ entry.outcome }}</span>
                            </div>
                        </div>
                        <p class="empty" v-else>No requests sent yet.</p>
                    </section>
                </div>
            </aside>
        </div>

        <footer class="statusbar">
            <span :class="errorText ? 'statusbar__text statusbar__text--error' : 'statusbar__text'">{{ statusLine() }}</span>
            <span class="statusbar__spacer"></span>
            <span class="statusbar__meta">{{ designSummary() }}</span>
            <span class="statusbar__meta">{{ hostPillLabel() }}</span>
            <span class="statusbar__meta">{{ engineLabel() }}</span>
            <span class="statusbar__meta">zoom 100%</span>
        </footer>

        <div class="toast" v-if="toast" :class="toastTone()" role="status">
            <div class="toast__body">
                <b class="toast__title">{{ toast.title }}</b>
                <span class="toast__message">{{ toast.message }}</span>
            </div>
            <button type="button" class="btn btn--small" @click="dismissToast">Dismiss</button>
        </div>
    </div>
</template>

<style>
.studio {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--oed-bg);
    color: var(--oed-ink);
    font-size: 12px;
}

.studio button:focus-visible,
.studio input:focus-visible,
.studio select:focus-visible {
    outline: 2px solid var(--oed-accent);
    outline-offset: 1px;
}

.winbar {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: stretch;
    height: 38px;
    min-height: 38px;
    border-bottom: 1px solid var(--oed-chrome-line);
    background: var(--oed-chrome);
    color: var(--oed-chrome-ink);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
}

.winbar__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 100%;
    min-width: 0;
    padding: 0 10px 0 12px;
}

.winbar__mark {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    border: 1px solid var(--oed-chrome-muted);
    border-radius: 0;
    background: transparent;
    color: var(--oed-chrome-ink);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
}

.winbar__name {
    flex: 0 0 auto;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
}

.winbar__divider {
    flex: 0 0 auto;
    width: 1px;
    height: 16px;
    background: #39434a;
}

.winbar__doc {
    overflow: hidden;
    max-width: 300px;
    color: var(--oed-chrome-muted);
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.winbar__commands {
    display: flex;
    align-items: stretch;
    min-width: 0;
    height: 100%;
}

.winbar__group {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding: 0 9px;
    border-left: 1px solid #2b3339;
}

.winbar__group:first-child {
    border-left: 0;
}

.winbar__label {
    color: var(--oed-chrome-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
}

.winbar__row {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 24px;
}

.winbar__btn {
    height: 24px;
    padding: 0 8px;
    border: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    color: var(--oed-chrome-ink);
    font-size: 11px;
    line-height: 1;
    white-space: nowrap;
    transition: background 0.1s linear, border-color 0.1s linear;
}

.winbar__btn:hover:not(:disabled) {
    border-color: #39434a;
    background: var(--oed-chrome-hover);
}

.winbar__btn:disabled {
    color: #657076;
    cursor: default;
}

.winbar__btn--on {
    border-color: var(--oed-accent);
    background: var(--oed-chrome-2);
    color: #f2f6ff;
}

.winbar__btn--icon {
    width: 24px;
    padding: 0;
}

.winbar__zoom {
    padding: 0 3px;
    color: var(--oed-chrome-muted);
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
}

.winbar__spacer {
    flex: 1 1 auto;
    align-self: stretch;
    min-width: 16px;
}

.winbar__end {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 100%;
    padding-left: 8px;
}

.winbar__status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.winbar__led {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--oed-steel);
}

.winbar__led--idle {
    background: var(--oed-chrome-muted);
}

.winbar__mode {
    color: var(--oed-chrome-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
}

.winbar__controls {
    display: flex;
    align-items: stretch;
    height: 100%;
    margin-left: 2px;
}

.winbar__ctl {
    display: grid;
    place-items: center;
    width: 44px;
    height: 38px;
    padding: 0;
    border: 0;
    border-left: 1px solid #2b3339;
    border-radius: 0;
    background: transparent;
    color: var(--oed-chrome-ink);
}

.winbar__ctl:hover {
    background: var(--oed-chrome-hover);
}

.winbar__ctl--close:hover {
    background: var(--oed-danger);
    color: #ffffff;
}

.winbar__icon {
    display: block;
}

.chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: 0 0 auto;
    padding: 1px 7px;
    border: 1px solid var(--oed-line);
    border-radius: var(--oed-radius);
    background: var(--oed-surface-2);
    color: var(--oed-muted);
    font-size: 10px;
    letter-spacing: 0.03em;
    white-space: nowrap;
}

.chip--ok {
    border-color: rgba(15, 118, 110, 0.35);
    background: rgba(15, 118, 110, 0.1);
    color: var(--oed-steel);
}

.chip--warn {
    border-color: rgba(31, 111, 235, 0.3);
    background: var(--oed-accent-soft);
    color: var(--oed-accent);
}

.chip--idle {
    background: var(--oed-surface-2);
    color: var(--oed-muted);
}

.chip--accent {
    border-color: var(--oed-accent);
    background: var(--oed-accent-soft);
    color: var(--oed-accent);
    font-family: "Cascadia Code", "Consolas", monospace;
}

.btn {
    padding: 4px 9px;
    border: 1px solid var(--oed-line);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
    color: var(--oed-ink);
    font-size: 11.5px;
    line-height: 1.5;
    white-space: nowrap;
    transition: border-color 0.1s linear, background 0.1s linear;
}

.btn:hover:not(:disabled) {
    border-color: var(--oed-accent);
}

.btn:disabled {
    color: var(--oed-muted);
    cursor: default;
    opacity: 0.65;
}

.btn--strong {
    border-color: var(--oed-accent);
    background: var(--oed-accent);
    color: #f6faff;
}

.btn--strong:hover:not(:disabled) {
    background: #1b5fca;
}

.btn--small {
    padding: 2px 7px;
    font-size: 10.5px;
}

.btn--wide {
    width: 100%;
}

.pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border: 1px solid var(--oed-line);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
    font-size: 10.5px;
    white-space: nowrap;
}

.pill--ok {
    border-color: rgba(15, 118, 110, 0.35);
    color: var(--oed-steel);
}

.pill--warn {
    border-color: rgba(180, 35, 24, 0.3);
    color: var(--oed-danger);
}

.pill--idle {
    color: var(--oed-muted);
}

.dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--oed-steel);
}

.dot--idle {
    background: var(--oed-muted);
    opacity: 0.55;
}

.export-panel {
    position: absolute;
    top: calc(100% + 6px);
    right: 12px;
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 9px;
    width: 292px;
    padding: 13px;
    border: 1px solid var(--oed-line-strong);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
}

.export-panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 12px;
}

.export-panel__actions {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.field__label {
    color: var(--oed-muted);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.readout {
    margin: 0;
    padding: 5px 8px;
    border: 1px dashed var(--oed-line);
    border-radius: var(--oed-radius);
    background: var(--oed-surface-2);
    color: var(--oed-ink);
    font-size: 10.5px;
    word-break: break-all;
    user-select: text;
}

.input {
    width: 100%;
    padding: 4px 8px;
    border: 1px solid var(--oed-line);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
    color: var(--oed-ink);
    font-size: 11.5px;
    user-select: text;
}

.input--path {
    max-width: 360px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
}

.shortcuts {
    position: absolute;
    top: calc(100% + 6px);
    right: 12px;
    z-index: 40;
    width: 286px;
    padding: 12px 13px;
    border: 1px solid var(--oed-line-strong);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
}

.shortcuts__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 12px;
}

.shortcuts__list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
}

.shortcut {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 4px 0;
    border-bottom: 1px solid var(--oed-surface-2);
}

.shortcut:last-child {
    border-bottom: 0;
}

.shortcut dt {
    color: var(--oed-ink);
    font-size: 11.5px;
}

.shortcut dd {
    margin: 0;
    color: var(--oed-muted);
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 10.5px;
    white-space: nowrap;
}

.context {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    min-height: 32px;
    padding: 0 12px;
    border-bottom: 1px solid var(--oed-line-strong);
    background: var(--oed-surface-2);
}

.path-field {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
}

.path-field__label {
    color: var(--oed-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.context__hint {
    margin: 0;
    color: var(--oed-muted);
    font-size: 10.5px;
}

.context__pills {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
}

.banner {
    padding: 7px 14px;
    border-bottom: 1px solid rgba(31, 111, 235, 0.2);
    background: var(--oed-accent-soft);
    color: var(--oed-ink);
    font-size: 11px;
}

.workspace {
    flex: 1;
    min-height: 0;
    min-width: 0;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 300px;
}

.sidebar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 0;
    padding: 10px;
    border-right: 1px solid var(--oed-line);
    background: var(--oed-surface-2);
    overflow: auto;
}

.panel {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px;
    border: 1px solid var(--oed-line);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
}

.panel__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
}

.panel__head h2,
.card__title {
    margin: 0;
    color: var(--oed-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.panel__count {
    color: var(--oed-muted);
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
}

.facts {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 5px 9px;
    margin: 0;
}

.facts dt {
    color: var(--oed-muted);
    font-size: 10.5px;
}

.facts dd {
    margin: 0;
    overflow: hidden;
    font-size: 11px;
    text-overflow: ellipsis;
    user-select: text;
}

.mono {
    font-family: "Cascadia Code", "Consolas", monospace;
    font-variant-numeric: tabular-nums;
    word-break: break-all;
}

.ellipsis {
    white-space: nowrap;
    text-overflow: ellipsis;
}

.empty {
    margin: 0;
    color: var(--oed-muted);
    font-size: 11px;
    line-height: 1.5;
}

.note {
    margin: 0;
    color: var(--oed-muted);
    font-size: 11px;
    line-height: 1.5;
    user-select: text;
}

.sheets {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.sheet-actions {
    display: flex;
    gap: 4px;
    margin-bottom: 6px;
}

.sheet-form {
    display: flex;
    gap: 4px;
    margin-bottom: 6px;
}

.sheet-form .input {
    flex: 1 1 auto;
    min-width: 0;
}

.sheet {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    width: 100%;
    padding: 6px 7px;
    border: 1px solid var(--oed-line);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
    text-align: left;
}

.sheet:hover {
    border-color: var(--oed-line-strong);
}

.sheet--active {
    border-color: var(--oed-accent);
    background: var(--oed-accent-soft);
}

.sheet__index {
    min-width: 12px;
    color: var(--oed-muted);
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
}

.sheet__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.sheet__title {
    overflow: hidden;
    font-size: 11.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sheet__meta {
    color: var(--oed-muted);
    font-size: 10px;
}

.targets {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.target {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 10.5px;
}

.target__name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--oed-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.target__state {
    color: var(--oed-muted);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.canvas {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--oed-bg);
}

.canvas__bar {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 5px 11px;
    border-bottom: 1px solid var(--oed-line);
    background: var(--oed-surface);
}

.canvas__title {
    font-size: 11.5px;
    font-weight: 600;
}

.canvas__zoom {
    color: var(--oed-muted);
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
}

.rulers {
    flex: 1;
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    grid-template-rows: 19px minmax(0, 1fr);
    min-width: 0;
    min-height: 0;
}

.ruler-corner {
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid var(--oed-line);
    border-bottom: 1px solid var(--oed-line);
    background: var(--oed-surface-2);
    color: var(--oed-muted);
    font-size: 8.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.ruler {
    background: var(--oed-surface-2);
    color: var(--oed-muted);
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 8.5px;
    font-variant-numeric: tabular-nums;
}

.ruler--h {
    position: relative;
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--oed-line);
    overflow: hidden;
}

.ruler--h .ruler__tick {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    padding-left: 3px;
    border-left: 1px solid var(--oed-line);
}

.ruler--h .ruler__tick--last {
    flex: 0 0 0;
    position: relative;
    padding: 0;
}

.ruler--h .ruler__tick--last .ruler__label {
    position: absolute;
    top: 50%;
    right: 2px;
    transform: translateY(-50%);
}

.ruler--v {
    position: relative;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--oed-line);
    overflow: hidden;
}

.ruler--v .ruler__tick {
    flex: 1 1 0;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 1px 3px 0 0;
    border-top: 1px solid var(--oed-line);
}

.ruler--v .ruler__tick--last {
    flex: 0 0 0;
    position: relative;
    padding: 0;
}

.ruler--v .ruler__tick--last .ruler__label {
    position: absolute;
    right: 3px;
    bottom: 1px;
}

.surface {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    padding: 34px 26px 60px;
    overflow: auto;
    background: var(--oed-work);
}

.artboard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    width: min(480px, 100%);
    padding: 26px 28px;
    border: 1px solid var(--oed-line-strong);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
}

.artboard__eyebrow {
    color: var(--oed-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.artboard__title {
    font-size: 16px;
    line-height: 1.25;
}

.artboard__id {
    color: var(--oed-muted);
    font-size: 10px;
}

.artboard__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 10px;
    margin-top: 6px;
    color: var(--oed-ink);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
}

.artboard__facts span {
    padding: 1px 7px;
    border: 1px solid var(--oed-line);
    border-radius: var(--oed-radius);
    background: var(--oed-surface-2);
}

.artboard__note {
    margin: 10px 0 0;
    padding-top: 9px;
    border-top: 1px dashed var(--oed-line);
    color: var(--oed-muted);
    font-size: 11px;
    line-height: 1.5;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    max-width: 320px;
    text-align: center;
}

.empty-state__mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--oed-line-strong);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
    color: var(--oed-accent);
    font-size: 19px;
    font-weight: 700;
}

.empty-state__title {
    font-size: 14px;
}

.empty-state__hint {
    margin: 0;
    color: var(--oed-muted);
    font-size: 11px;
    line-height: 1.55;
}

.empty-state__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
}

.tools {
    position: absolute;
    bottom: 12px;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 4px 8px;
    border: 1px solid var(--oed-line-strong);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
    transform: translateX(-50%);
}

.tools__label {
    padding-right: 4px;
    color: var(--oed-muted);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.tool {
    padding: 3px 8px;
    border: 1px solid transparent;
    border-radius: var(--oed-radius);
    background: var(--oed-surface-2);
    color: var(--oed-muted);
    font-size: 10px;
    cursor: default;
}

.tools__badge {
    margin-left: 4px;
    color: var(--oed-steel);
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 9px;
    white-space: nowrap;
}

.inspector {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    border-left: 1px solid var(--oed-line);
    background: var(--oed-surface);
}

.tabs {
    display: flex;
    gap: 2px;
    padding: 6px 6px 0;
    border-bottom: 1px solid var(--oed-line);
}

.tab {
    padding: 5px 8px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--oed-muted);
    font-size: 10.5px;
}

.tab:hover {
    color: var(--oed-ink);
}

.tab--active {
    border-bottom-color: var(--oed-accent);
    color: var(--oed-accent);
}

.tab-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-height: 0;
    padding: 10px;
    overflow: auto;
}

.card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px;
    border: 1px solid var(--oed-line);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
}

.card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.card__actions {
    display: flex;
    gap: 4px;
}

.cap-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--oed-line);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
    overflow: hidden;
}

.cap-row {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 9px;
    border-bottom: 1px solid var(--oed-surface-2);
    font-size: 10.5px;
}

.cap-row:last-child {
    border-bottom: 0;
}

.cap-row__label {
    flex: 1;
    min-width: 0;
    color: var(--oed-ink);
}

.cap-row__value {
    color: var(--oed-muted);
    font-size: 10px;
}

.issues {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 10px;
}

.issue {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 6px;
    padding: 4px 6px;
    border: 1px solid var(--oed-line);
    border-radius: var(--oed-radius);
    background: var(--oed-surface-2);
}

.issue__code {
    color: var(--oed-muted);
    font-size: 9.5px;
}

.issue__message {
    flex-basis: 100%;
    color: var(--oed-ink);
    font-size: 10.5px;
    line-height: 1.4;
}

.chip--error {
    border-color: rgba(180, 35, 24, 0.35);
    background: rgba(180, 35, 24, 0.08);
    color: var(--oed-danger);
}

.chip--warning {
    border-color: rgba(31, 111, 235, 0.3);
    background: var(--oed-accent-soft);
    color: var(--oed-accent);
}

.chip--info {
    border-color: var(--oed-line);
    color: var(--oed-muted);
}

.log {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 9.5px;
}

.log__row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    gap: 6px;
    align-items: baseline;
}

.log__time {
    color: var(--oed-muted);
    font-variant-numeric: tabular-nums;
}

.log__type {
    overflow: hidden;
    color: var(--oed-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.log__outcome {
    color: var(--oed-muted);
    letter-spacing: 0.03em;
    text-transform: uppercase;
}

.log__outcome--ok {
    color: var(--oed-steel);
}

.log__outcome--error {
    color: var(--oed-danger);
}

.log__outcome--pending {
    color: var(--oed-accent);
}

.statusbar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 12px;
    border-top: 1px solid var(--oed-line);
    background: var(--oed-surface);
    color: var(--oed-muted);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
}

.statusbar__text {
    overflow: hidden;
    min-width: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.statusbar__text--error {
    color: var(--oed-danger);
}

.statusbar__spacer {
    flex: 1;
}

.statusbar__meta {
    white-space: nowrap;
}

.toast {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 60;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    width: min(360px, calc(100vw - 32px));
    padding: 10px 11px;
    border: 1px solid var(--oed-line-strong);
    border-left: 3px solid var(--oed-accent);
    border-radius: var(--oed-radius);
    background: var(--oed-surface);
    animation: toast-in 0.16s ease-out;
}

.toast--error {
    border-left-color: var(--oed-danger);
}

.toast--ok {
    border-left-color: var(--oed-steel);
}

.toast--warn {
    border-left-color: var(--oed-accent);
}

.toast__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.toast__title {
    font-size: 11.5px;
    word-break: break-word;
}

.toast__message {
    color: var(--oed-muted);
    font-size: 10.5px;
    line-height: 1.45;
    word-break: break-word;
    user-select: text;
}

@keyframes toast-in {
    from {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 1180px) {
    .workspace {
        grid-template-columns: 240px minmax(0, 1fr) 260px;
    }

    .winbar__doc,
    .winbar__divider {
        display: none;
    }
}

@media (max-width: 1000px) {
    .workspace {
        grid-template-columns: 240px minmax(0, 1fr);
    }

    .inspector {
        display: none;
    }

    .winbar__group--view {
        display: none;
    }
}

@media (max-width: 820px) {
    .workspace {
        grid-template-columns: minmax(0, 1fr);
    }

    .sidebar {
        display: none;
    }

    .winbar__group {
        padding: 0 6px;
    }

    .winbar__group--doc {
        display: none;
    }

    .export-panel {
        right: 8px;
    }

    .context__hint {
        display: none;
    }
}

@media (prefers-reduced-motion: reduce) {
    .btn,
    .winbar__btn,
    .toast {
        transition: none;
        animation: none;
    }
}

</style>

<script client>
export default class IndexPage {
    static meta() {
        return {
            title: "OpenEDA Studio",
            description:
                "Desktop shell for one editable EDA design: schematic editing with undo/redo, sheet editing, ERC inspection, and netlist/SVG/BOM/PDF projection, with unsupported capabilities reported honestly.",
        };
    }

    hostReady = false;
    customChrome = false;
    status = "Starting the studio";
    errorText = "";
    path = "";
    design = null;
    objects = null;
    capabilities = null;
    handle = 0;
    currentSheetId = "";
    sheetEditing = "";
    sheetDraft = "";
    tab = "properties";
    exportOpen = false;
    exportFormat = "";
    shortcutsOpen = false;
    toast = null;
    toastTimer = 0;
    dragTimer = 0;
    winbarObserver = null;
    inspectResult = null;
    seq = 0;
    pending = {};
    log = [];
    requestsSent = 0;
    lastRequestType = "";
    lastRequestId = "";
    lastErrorCode = "";
    lastErrorText = "";

    onMount() {
        // Static render has no window; the client mount takes over in the
        // WebView or a regular browser tab.
        if (typeof window === "undefined") {
            return;
        }
        const webview = window.chrome && window.chrome.webview;
        if (webview) {
            this.hostReady = true;
            webview.addEventListener("message", (event) => this.onHostMessage(event));
            void this.start();
        } else {
            this.status = "Preview mode";
            this.errorText = "The native host is not attached.";
        }
        window.addEventListener("keydown", (event) => this.onKeyDown(event));
        window.addEventListener("resize", () => this.scheduleDragRegions());
        if (typeof ResizeObserver !== "undefined") {
            const bar = document.querySelector(".winbar");
            if (bar) {
                this.winbarObserver = new ResizeObserver(() => this.scheduleDragRegions());
                this.winbarObserver.observe(bar);
            }
        }
    }

    onUnmount() {
        if (this.dragTimer) {
            clearTimeout(this.dragTimer);
            this.dragTimer = 0;
        }
        if (this.winbarObserver) {
            this.winbarObserver.disconnect();
            this.winbarObserver = null;
        }
    }

    async start() {
        try {
            const ready = await this.rpc("ready", {});
            this.customChrome = !!(ready && ready.window && ready.window.customChrome);
            this.reportDragRegions();
            const response = await this.rpc("capabilities", {});
            this.capabilities = response.capabilities;
            const targets = this.exportTargetNames();
            const supported = targets.find((name) => this.capabilities.exportTargets[name] === "supported");
            if (!this.exportFormat && (supported || targets.length)) {
                this.exportFormat = supported || targets[0];
            }
            this.status = "Connected to the native host";
            this.errorText = "";
        } catch (error) {
            this.fail(error);
        }
    }

    scheduleDragRegions() {
        if (this.dragTimer) {
            clearTimeout(this.dragTimer);
        }
        this.dragTimer = setTimeout(() => {
            this.dragTimer = 0;
            this.reportDragRegions();
        }, 120);
    }

    reportDragRegions() {
        if (!this.hostReady || !this.customChrome || typeof document === "undefined") {
            return;
        }
        const rects = [];
        document.querySelectorAll("[data-drag]").forEach((node) => {
            const box = node.getBoundingClientRect();
            const width = Math.round(box.width);
            const height = Math.round(box.height);
            if (width <= 0 || height <= 0) {
                return;
            }
            rects.push({ x: Math.round(box.left), y: Math.round(box.top), width, height });
        });
        this.rpc("window.dragRegions", { rects }).catch(() => {});
    }

    windowMinimize() {
        this.rpc("window.minimize", {}).catch(() => {});
    }

    windowToggleMaximize() {
        this.rpc("window.toggleMaximize", {}).catch(() => {});
    }

    windowClose() {
        this.rpc("window.close", {}).catch(() => {});
    }

    rpc(type, payload) {
        const webview = window.chrome && window.chrome.webview;
        if (!webview) {
            return Promise.reject(new Error("native window unavailable"));
        }
        const id = `q${++this.seq}`;
        this.requestsSent += 1;
        this.lastRequestType = type;
        this.lastRequestId = id;
        const entry = {
            key: id,
            type,
            outcome: "pending",
            tone: "log__outcome log__outcome--pending",
            time: this.clock(),
        };
        this.log = [entry].concat(this.log).slice(0, 8);
        return new Promise((resolve, reject) => {
            this.pending[id] = { resolve, reject };
            webview.postMessage(JSON.stringify(Object.assign({ type, id }, payload || {})));
        });
    }

    clock() {
        const now = new Date();
        const pad = (value) => String(value).padStart(2, "0");
        return `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
    }

    finishLog(id, outcome) {
        const tone = outcome === "ok" ? "log__outcome log__outcome--ok" : "log__outcome log__outcome--error";
        this.log = this.log.map((entry) => {
            if (entry.key !== id) {
                return entry;
            }
            return { key: entry.key, type: entry.type, time: entry.time, outcome, tone };
        });
    }

    onHostMessage(event) {
        let data = event.data;
        if (typeof data === "string") {
            try {
                data = JSON.parse(data);
            } catch {
                return;
            }
        }
        if (!data || typeof data !== "object" || typeof data.id !== "string") {
            return;
        }
        const entry = this.pending[data.id];
        if (!entry) {
            return;
        }
        delete this.pending[data.id];
        const type = typeof data.type === "string" ? data.type : "";
        if (type.endsWith("Result")) {
            this.finishLog(data.id, "ok");
            entry.resolve(data);
        } else {
            this.finishLog(data.id, "error");
            entry.reject(new Error(data.message || type || "request failed"));
        }
    }

    fail(error) {
        const message = error instanceof Error ? error.message : String(error);
        const split = message.indexOf(":");
        const head = split > 0 ? message.slice(0, split).trim() : "";
        const knownCode = /^[a-z][a-z0-9-]*\/[a-z][a-z0-9-]*$/.test(head);
        const code = knownCode ? head : "session/request-failed";
        this.lastErrorCode = code;
        this.lastErrorText = message;
        this.errorText = message;
        this.status = "Request rejected";
        this.showToast("error", code, message);
    }

    firstSheetId() {
        return this.design && this.design.sheets.length ? this.design.sheets[0].id : "";
    }

    adopt(response, nextPath) {
        if (!response || !response.design) {
            this.status = "The host answered without a design";
            this.errorText = "No design arrived, so nothing was adopted.";
            return;
        }
        const previous = this.handle;
        this.handle = response.handle;
        this.design = response.design;
        this.objects = null;
        this.currentSheetId = this.firstSheetId();
        this.path = nextPath;
        this.inspectResult = null;
        this.exportOpen = false;
        this.sheetEditing = "";
        this.sheetDraft = "";
        this.status = `Design ${response.design.id} at revision ${response.design.revision}`;
        this.errorText = "";
        if (previous && previous !== this.handle) {
            void this.closeQuietly(previous);
        }
        void this.loadObjects();
    }

    /**
     * Adopts the summary returned by an edit without touching the handle.
     * Undo, redo and sheet edits answer with `design` but no new handle.
     */
    applyEdit(response, note) {
        if (!response || !response.design) {
            this.status = "The host answered without a design";
            this.errorText = "No design arrived, so nothing was adopted.";
            return false;
        }
        this.design = response.design;
        this.inspectResult = null;
        if (!this.design.sheets.some((sheet) => sheet.id === this.currentSheetId)) {
            this.currentSheetId = this.firstSheetId();
        }
        if (note) {
            this.status = note;
        }
        this.errorText = "";
        void this.loadObjects();
        return true;
    }

    historyLabel() {
        if (!this.design || !this.design.history) {
            return "no design";
        }
        return `${this.design.history.undo} undo / ${this.design.history.redo} redo (limit ${this.design.history.limit})`;
    }

    async loadObjects() {
        if (!this.handle) {
            this.objects = null;
            return;
        }
        try {
            this.objects = await this.rpc("design.list", { handle: this.handle });
        } catch (error) {
            this.fail(error);
        }
    }

    async closeQuietly(handle) {
        try {
            await this.rpc("design.close", { handle });
        } catch {
            // A refused close carries its own stable code.
        }
    }

    designTitle() {
        return this.design ? this.design.title || "Untitled design" : "No design open";
    }

    pathLine() {
        const path = this.path.trim();
        if (path) {
            return path;
        }
        return this.design ? "Unsaved design" : "No path yet";
    }

    hasPath() {
        return this.path.trim().length > 0;
    }

    revisionLabel() {
        if (!this.design) {
            return "no design";
        }
        return this.hasPath() ? `r${this.design.revision}` : "unsaved";
    }

    revisionChipClass() {
        if (!this.design) {
            return "chip chip--idle";
        }
        return this.hasPath() ? "chip" : "chip chip--warn";
    }

    connectionLabel() {
        return this.hostReady ? "Native host" : "Preview";
    }

    modeLabel() {
        return this.hostReady ? "NATIVE" : "PREVIEW";
    }

    hostLabel() {
        return this.hostReady ? "native WebView" : "browser preview";
    }

    hostPillLabel() {
        return this.hostReady ? "native host" : "preview";
    }

    engineReported() {
        if (!this.capabilities) {
            return false;
        }
        const project = this.capabilities.project;
        return project.import !== "unsupported" || project.edit !== "unsupported" || project.export !== "unsupported";
    }

    engineLabel() {
        if (!this.capabilities) {
            return "engine unknown";
        }
        return this.engineReported() ? "engine reported" : "engine not connected";
    }

    enginePillClass() {
        return this.engineReported() ? "pill pill--ok" : "pill pill--idle";
    }

    sheetCountLabel() {
        return this.design ? `${this.design.sheets.length} sheets` : "none";
    }

    totalObjects() {
        if (!this.design || !this.design.sheets) {
            return 0;
        }
        let total = 0;
        this.design.sheets.forEach((sheet) => {
            total += sheet.objects;
        });
        return total;
    }

    designSummary() {
        if (!this.design) {
            return "no design open";
        }
        return `rev ${this.design.revision} · ${this.design.sheets.length} sheets · ${this.totalObjects()} objects`;
    }

    objectCountLabel() {
        if (!this.objects) {
            return "none";
        }
        return `${this.objects.components.length} components · ${this.objects.nets.length} nets`;
    }

    issueTone(issue) {
        if (issue.severity === "error") {
            return "chip chip--error";
        }
        return issue.severity === "warning" ? "chip chip--warning" : "chip chip--info";
    }

    statusLine() {
        return this.errorText ? this.errorText : this.status;
    }

    lastRequestLabel() {
        return this.lastRequestType ? `${this.lastRequestType} ${this.lastRequestId}` : "none";
    }

    lastErrorLabel() {
        return this.lastErrorCode ? this.lastErrorCode : "none";
    }

    exportTitle() {
        if (!this.design) {
            return "Open a design before exporting";
        }
        if (!this.capabilities) {
            return "The capability matrix has not loaded";
        }
        return "Export a projection (Ctrl/Cmd+E)";
    }

    exportTargetNames() {
        return this.capabilities ? Object.keys(this.capabilities.exportTargets) : [];
    }

    rulerTicks() {
        const ticks = [];
        for (let step = 0; step <= 8; step += 1) {
            ticks.push({ value: step * 100, last: step === 8 });
        }
        return ticks;
    }

    shortcutList() {
        return [
            { label: "New", keys: "Ctrl/Cmd+N" },
            { label: "Open", keys: "Ctrl/Cmd+O" },
            { label: "Save", keys: "Ctrl/Cmd+S" },
            { label: "Undo", keys: "Ctrl/Cmd+Z" },
            { label: "Redo", keys: "Ctrl/Cmd+Shift+Z or Ctrl+Y" },
            { label: "Export", keys: "Ctrl/Cmd+E" },
            { label: "Close design", keys: "Ctrl/Cmd+W" },
            { label: "Inspector tabs", keys: "Ctrl+1 / 2 / 3" },
            { label: "Dismiss", keys: "Esc" },
        ];
    }

    statusTone(level) {
        if (level === "supported") {
            return "chip chip--ok";
        }
        if (level === "partial") {
            return "chip chip--warn";
        }
        return "chip chip--idle";
    }

    countFormats(formats, field) {
        return Object.keys(formats).filter((name) => formats[name][field] === "supported").length;
    }

    countSupported(map) {
        return Object.keys(map).filter((name) => map[name] === "supported").length;
    }

    projectSummary() {
        const project = this.capabilities.project;
        return `import ${project.import} · edit ${project.edit} · export ${project.export}`;
    }

    capabilityRows() {
        const caps = this.capabilities;
        if (!caps) {
            return [];
        }
        const formats = caps.formats || {};
        const checks = caps.checks || {};
        const renderers = caps.renderers || {};
        const exportTargets = caps.exportTargets || {};
        const declared = Object.keys(formats).length;
        const importable = this.countFormats(formats, "import");
        const editable = this.countFormats(formats, "edit");
        const exportable = this.countFormats(formats, "export");
        const checksSupported = this.countSupported(checks);
        const renderersSupported = this.countSupported(renderers);
        const targetsSupported = this.countSupported(exportTargets);
        const project = caps.project;
        return [
            { key: "project-import", label: "Project import", value: project.import, status: project.import, tone: this.statusTone(project.import) },
            { key: "project-edit", label: "Project edit", value: project.edit, status: project.edit, tone: this.statusTone(project.edit) },
            { key: "project-export", label: "Project export", value: project.export, status: project.export, tone: this.statusTone(project.export) },
            { key: "formats", label: "Formats declared", value: String(declared), status: "declared", tone: "chip chip--idle" },
            { key: "formats-import", label: "Importable formats", value: String(importable), status: importable ? "supported" : "unsupported", tone: this.statusTone(importable ? "supported" : "unsupported") },
            { key: "formats-edit", label: "Editable formats", value: String(editable), status: editable ? "supported" : "unsupported", tone: this.statusTone(editable ? "supported" : "unsupported") },
            { key: "formats-export", label: "Exportable formats", value: String(exportable), status: exportable ? "supported" : "unsupported", tone: this.statusTone(exportable ? "supported" : "unsupported") },
            { key: "checks", label: "Checks supported", value: String(checksSupported), status: checksSupported ? "supported" : "unsupported", tone: this.statusTone(checksSupported ? "supported" : "unsupported") },
            { key: "renderers", label: "Renderers supported", value: String(renderersSupported), status: renderersSupported ? "supported" : "unsupported", tone: this.statusTone(renderersSupported ? "supported" : "unsupported") },
            { key: "targets", label: "Export targets supported", value: String(targetsSupported), status: targetsSupported ? "supported" : "unsupported", tone: this.statusTone(targetsSupported ? "supported" : "unsupported") },
        ];
    }

    capabilityNote() {
        return this.engineReported()
            ? "Counts come from the capability matrix the host reported; unsupported entries reject with capability/not-implemented."
            : "The host has not reported a capability matrix yet, so nothing is assumed.";
    }

    exportTargetRows() {
        const targets = this.capabilities ? this.capabilities.exportTargets || {} : {};
        return Object.keys(targets).map((name) => {
            const level = targets[name];
            const supported = level === "supported";
            return {
                name,
                status: level,
                supported,
                dot: supported ? "dot" : "dot dot--idle",
            };
        });
    }

    checkRows() {
        const checks = this.capabilities ? this.capabilities.checks || {} : {};
        return Object.keys(checks).map((name) => {
            const level = checks[name];
            return {
                name,
                status: level,
                dot: level === "supported" ? "dot" : "dot dot--idle",
            };
        });
    }

    exportBadgeClass() {
        if (!this.capabilities) {
            return "chip chip--idle";
        }
        return this.supportedTargetCount() > 0 ? "chip chip--ok" : "chip chip--idle";
    }

    exportBadgeLabel() {
        if (!this.capabilities) {
            return "capabilities unknown";
        }
        const count = this.supportedTargetCount();
        return count > 0 ? `${count} supported` : "none supported";
    }

    exportNote() {
        const level = this.capabilities ? this.capabilities.exportTargets[this.exportFormat] : undefined;
        if (level === "supported") {
            if (this.exportFormat === "bom") {
                return "Writes a Comment,Designator,Quantity CSV at the current revision.";
            }
            if (this.exportFormat === "pdf") {
                return "Writes a one-page A4 landscape vector PDF at the current revision.";
            }
            return "Writes the current revision to the target path.";
        }
        return "This target reports capability/not-implemented; choose a target marked supported.";
    }

    supportedTargetCount() {
        if (!this.capabilities) {
            return 0;
        }
        return this.countSupported(this.capabilities.exportTargets || {});
    }

    exportTargetPath() {
        const base = this.path.trim();
        if (!base || !this.exportFormat) {
            return "";
        }
        const slash = Math.max(base.lastIndexOf("/"), base.lastIndexOf("\\"));
        const dot = base.lastIndexOf(".");
        const stem = dot > slash ? base.slice(0, dot) : base;
        const extension = this.exportFormat === "bom" ? "csv" : this.exportFormat;
        return `${stem}.${extension}`;
    }

    exportTargetReadout() {
        const target = this.exportTargetPath();
        return target ? target : "Type a path in the context bar to choose a target file.";
    }

    canExport() {
        return (
            this.hostReady &&
            !!this.design &&
            !!this.capabilities &&
            this.exportFormat !== "" &&
            this.capabilities.exportTargets[this.exportFormat] === "supported" &&
            this.exportTargetPath() !== ""
        );
    }

    inspectText() {
        if (!this.inspectResult) {
            return "No inspection has run for the open design.";
        }
        const issues = this.inspectResult.issues || [];
        const verdict = this.inspectResult.passed ? "Passed" : "Findings";
        return `${verdict} · ${issues.length} issues at revision ${this.inspectResult.revision}`;
    }

    selectSheet(event) {
        const sheetId = event.currentTarget.dataset.sheetId;
        if (sheetId) {
            this.currentSheetId = sheetId;
        }
    }

    async undoEdit() {
        if (!this.hostReady) {
            this.showToast("warn", "Preview mode", "The native WebView host is not attached.");
            return;
        }
        if (!this.handle || !this.design || !this.design.canUndo) {
            this.showToast("warn", "Nothing to undo", "This handle has no edit left to undo.");
            return;
        }
        try {
            const response = await this.rpc("design.undo", { handle: this.handle });
            this.applyEdit(response, `Undid to revision ${response.revision}`);
        } catch (error) {
            this.fail(error);
        }
    }

    async redoEdit() {
        if (!this.hostReady) {
            this.showToast("warn", "Preview mode", "The native WebView host is not attached.");
            return;
        }
        if (!this.handle || !this.design || !this.design.canRedo) {
            this.showToast("warn", "Nothing to redo", "This handle has no undone edit to reapply.");
            return;
        }
        try {
            const response = await this.rpc("design.redo", { handle: this.handle });
            this.applyEdit(response, `Redid to revision ${response.revision}`);
        } catch (error) {
            this.fail(error);
        }
    }

    beginAddSheet() {
        if (!this.handle || !this.design) {
            this.showToast("warn", "No design open", "Open a design before adding a sheet.");
            return;
        }
        this.sheetEditing = "add";
        this.sheetDraft = `Sheet ${this.design.sheets.length + 1}`;
    }

    beginRenameSheet() {
        if (!this.design) {
            return;
        }
        const sheet = this.design.sheets.find((candidate) => candidate.id === this.currentSheetId);
        if (!sheet) {
            this.showToast("warn", "No sheet selected", "Select a sheet before renaming it.");
            return;
        }
        this.sheetEditing = "rename";
        this.sheetDraft = sheet.name;
    }

    onSheetDraftInput(event) {
        this.sheetDraft = event.target.value;
    }

    cancelSheetEdit() {
        this.sheetEditing = "";
        this.sheetDraft = "";
    }

    async submitSheetEdit() {
        const name = this.sheetDraft.trim();
        if (!this.handle || !name || !this.sheetEditing) {
            return;
        }
        const mode = this.sheetEditing;
        try {
            if (mode === "add") {
                const response = await this.rpc("design.addSheet", { handle: this.handle, name });
                this.sheetEditing = "";
                this.sheetDraft = "";
                this.applyEdit(response, `Added sheet ${name}`);
                if (response.sheet && response.sheet.id) {
                    this.currentSheetId = response.sheet.id;
                }
            } else {
                const sheet = this.currentSheetId;
                const response = await this.rpc("design.renameSheet", { handle: this.handle, sheet, name });
                this.sheetEditing = "";
                this.sheetDraft = "";
                this.applyEdit(response, `Renamed ${sheet} to ${name}`);
            }
        } catch (error) {
            this.sheetEditing = "";
            this.sheetDraft = "";
            this.fail(error);
        }
    }

    async deleteSelectedSheet() {
        if (!this.handle || !this.currentSheetId) {
            return;
        }
        const sheet = this.currentSheetId;
        try {
            const response = await this.rpc("design.deleteSheet", { handle: this.handle, sheet });
            this.sheetEditing = "";
            this.sheetDraft = "";
            this.applyEdit(response, `Deleted sheet ${sheet}`);
            this.currentSheetId = this.firstSheetId();
        } catch (error) {
            this.fail(error);
        }
    }

    selectTab(event) {
        const tab = event.currentTarget.dataset.tab;
        if (tab) {
            this.tab = tab;
        }
    }

    onPathInput(event) {
        this.path = event.target.value;
    }

    toggleExport() {
        if (!this.hostReady) {
            this.showToast("warn", "Preview mode", "The native host is not attached.");
            return;
        }
        if (!this.design) {
            this.showToast("warn", "No design open", "Open a design before choosing an export target.");
            return;
        }
        if (!this.capabilities) {
            this.showToast("warn", "No capability matrix", "The host has not reported its export targets.");
            return;
        }
        this.exportOpen = !this.exportOpen;
        if (this.exportOpen) {
            this.shortcutsOpen = false;
        }
    }

    closeExport() {
        this.exportOpen = false;
    }

    onExportFormat(event) {
        this.exportFormat = event.target.value;
    }

    toggleShortcuts() {
        this.shortcutsOpen = !this.shortcutsOpen;
        if (this.shortcutsOpen) {
            this.exportOpen = false;
        }
    }

    closeOverlays() {
        this.exportOpen = false;
        this.shortcutsOpen = false;
    }

    toastTone() {
        return this.toast ? `toast toast--${this.toast.tone}` : "toast toast--warn";
    }

    showToast(tone, title, message) {
        if (this.toastTimer) {
            clearTimeout(this.toastTimer);
            this.toastTimer = 0;
        }
        this.toast = { tone, title, message };
        this.toastTimer = setTimeout(() => {
            this.toast = null;
            this.toastTimer = 0;
        }, 7000);
    }

    dismissToast() {
        if (this.toastTimer) {
            clearTimeout(this.toastTimer);
            this.toastTimer = 0;
        }
        this.toast = null;
    }

    diagnosticText() {
        const lines = [
            `host: ${this.hostLabel()}`,
            `connection: ${this.connectionLabel()}`,
            `requests: ${this.requestsSent}`,
            `last request: ${this.lastRequestLabel()}`,
            `last error: ${this.lastErrorLabel()}`,
        ];
        if (this.lastErrorText) {
            lines.push(`message: ${this.lastErrorText}`);
        }
        this.log.forEach((entry) => {
            lines.push(`${entry.time} ${entry.type} ${entry.outcome}`);
        });
        return lines.join("\n");
    }

    async copyDiagnostics() {
        if (typeof navigator === "undefined" || !navigator.clipboard || !navigator.clipboard.writeText) {
            this.showToast("warn", "Clipboard unavailable", "This host does not expose navigator.clipboard.");
            return;
        }
        try {
            await navigator.clipboard.writeText(this.diagnosticText());
            this.showToast("ok", "Diagnostics copied", `${this.log.length} recent requests copied.`);
        } catch {
            this.showToast("warn", "Copy failed", "The clipboard rejected the write.");
        }
    }

    clearDiagnostics() {
        this.log = [];
        this.lastErrorCode = "";
        this.lastErrorText = "";
        this.showToast("ok", "Diagnostics cleared", "The request log is empty.");
    }

    async newDesign() {
        if (!this.hostReady) {
            this.showToast("warn", "Preview mode", "The native WebView host is not attached.");
            return;
        }
        try {
            const response = await this.rpc("design.create", { request: { title: "Untitled design" } });
            this.adopt(response, "");
        } catch (error) {
            this.fail(error);
        }
    }

    async openDesign() {
        if (!this.hostReady) {
            this.showToast("warn", "Preview mode", "The native WebView host is not attached.");
            return;
        }
        const path = this.path.trim();
        if (!path) {
            this.errorText = "Type a design path before opening.";
            this.status = "Open needs a path";
            return;
        }
        try {
            const response = await this.rpc("design.open", { path });
            this.adopt(response, path);
        } catch (error) {
            this.fail(error);
        }
    }

    async saveDesign() {
        if (!this.hostReady) {
            this.showToast("warn", "Preview mode", "The native WebView host is not attached.");
            return;
        }
        if (!this.handle || !this.design) {
            this.errorText = "Open or create a design before saving.";
            this.status = "Save needs a design";
            return;
        }
        const path = this.path.trim();
        if (!path) {
            this.errorText = "Type a design path before saving.";
            this.status = "Save needs a path";
            return;
        }
        try {
            const response = await this.rpc("design.save", { handle: this.handle, path, overwrite: true });
            const report = response.report;
            this.status = report ? `Saved ${report.bytes} bytes at revision ${report.revision}` : "Save finished without a report";
            this.errorText = "";
        } catch (error) {
            this.fail(error);
        }
    }

    async exportCurrent() {
        if (!this.canExport()) {
            this.showToast("warn", "Export unavailable", "Open a design and type a target path first.");
            return;
        }
        try {
            const response = await this.rpc("design.export", {
                handle: this.handle,
                format: this.exportFormat,
                target: this.exportTargetPath(),
                overwrite: true,
            });
            const report = response.report;
            if (report) {
                const artifact = report.artifact && report.artifact.kind ? report.artifact.kind : report.format;
                this.status = `Exported ${report.format} (${report.bytes} bytes, ${artifact}) at revision ${report.revision}`;
            } else {
                this.status = "Export finished without a report";
            }
            this.errorText = "";
            this.exportOpen = false;
        } catch (error) {
            this.fail(error);
        }
    }

    async closeDesign() {
        if (!this.hostReady || !this.handle) {
            return;
        }
        try {
            await this.rpc("design.close", { handle: this.handle });
            this.handle = 0;
            this.design = null;
            this.objects = null;
            this.currentSheetId = "";
            this.inspectResult = null;
            this.exportOpen = false;
            this.sheetEditing = "";
            this.sheetDraft = "";
            this.status = "Design closed";
            this.errorText = "";
        } catch (error) {
            this.fail(error);
        }
    }

    async inspectDesign() {
        if (!this.handle) {
            this.showToast("warn", "No design handle", "Open a design before running an inspection.");
            return;
        }
        try {
            const response = await this.rpc("design.inspect", { handle: this.handle });
            this.inspectResult = response.report ? response.report : null;
            this.status = this.inspectResult ? "Inspection finished" : "Inspection finished without a report";
            this.errorText = "";
        } catch (error) {
            this.fail(error);
        }
    }

    onKeyDown(event) {
        const target = event.target;
        const typing = !!target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.tagName === "SELECT");
        const mod = event.ctrlKey || event.metaKey;
        const key = event.key ? event.key.toLowerCase() : "";
        if (key === "escape") {
            event.preventDefault();
            this.closeOverlays();
            return;
        }
        if (mod && key === "w") {
            event.preventDefault();
            void this.closeDesign();
            return;
        }
        if (typing) {
            return;
        }
        if (mod && key === "z" && !event.shiftKey) {
            event.preventDefault();
            void this.undoEdit();
            return;
        }
        if (mod && (key === "y" || (key === "z" && event.shiftKey))) {
            event.preventDefault();
            void this.redoEdit();
            return;
        }
        if (mod && key === "n") {
            event.preventDefault();
            void this.newDesign();
            return;
        }
        if (mod && key === "o") {
            event.preventDefault();
            void this.openDesign();
            return;
        }
        if (mod && key === "s") {
            event.preventDefault();
            void this.saveDesign();
            return;
        }
        if (mod && key === "e") {
            event.preventDefault();
            void this.toggleExport();
            return;
        }
        if (mod && (event.key === "1" || event.key === "2" || event.key === "3")) {
            event.preventDefault();
            this.tab = event.key === "1" ? "properties" : event.key === "2" ? "capabilities" : "diagnostics";
        }
    }
}
</script>
