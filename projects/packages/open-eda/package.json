{
    "name": "@wae/open-eda",
    "version": "0.0.10",
    "description": "Schematic and PCB design documents: one editable model for capture, inspection, export and agent authoring",
    "license": "MPL-2.0",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "open-eda": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "locales"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/smoke.test.js"
    },
    "keywords": [
        "eda",
        "schematic",
        "pcb",
        "kicad",
        "netlist",
        "wae"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-os/OpenEDA.git",
        "directory": "projects/packages/open-eda"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "@wae/commander": "0.0.7"
    },
    "optionalDependencies": {
        "@wae/open-eda-darwin-arm64": "workspace:*",
        "@wae/open-eda-darwin-x64": "workspace:*",
        "@wae/open-eda-linux-arm64": "workspace:*",
        "@wae/open-eda-linux-x64": "workspace:*",
        "@wae/open-eda-win32-x64": "workspace:*"
    }
}
