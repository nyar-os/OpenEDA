<script client>
const DESIGN_FORMATS = [
    "kicad_sch",
    "kicad_pcb",
    "sch",
    "brd",
    "net",
    "edif",
    "spice",
    "cir",
    "gbr",
    "drl",
    "step",
    "svg",
    "pdf",
    "png",
    "bom",
];

const SUPPORTED_EXPORTS = new Set(["net", "svg", "bom", "pdf"]);

export default class IndexPage {
    formats = DESIGN_FORMATS.map((name) => {
        const supported = SUPPORTED_EXPORTS.has(name);
        return {
            name,
            importLevel: "unsupported",
            editLevel: "unsupported",
            exportLevel: supported ? "supported" : "unsupported",
            status: supported ? "export" : "declared",
            tone: supported ? "chip chip--ok" : "chip chip--idle",
        };
    });

    static meta() {
        return {
            title: "OpenEDA — editable schematic and PCB design",
            description:
                "OpenEDA keeps schematic capture, board layout, inspection and export on one editable design document for people and agents.",
        };
    }
}
</script>
