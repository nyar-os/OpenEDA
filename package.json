{
    "name": "open-eda-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "description": "OpenEDA workspace: schematic and PCB design, editable design documents, and agent skills",
    "keywords": ["eda", "schematic", "pcb", "kicad", "design"],
    "license": "MPL-2.0",
    "repository": "https://github.com/nyar-os/OpenEDA",
    "scripts": {
        "doc": "cargo doc --no-deps --all-features",
        "test:rust": "cargo test --release",
        "fmt": "cargo fmt --all",
        "p": "git push && git push --tags --prune",
        "reset": "git reset Head~ --soft",
        "u": "cargo upgrade --workspace",
        "check:rust": "cargo fmt -p open-eda-model -p open-eda-napi -- --check && cargo clippy -p open-eda-model -p open-eda-napi --all-targets -- -D warnings && cargo test -p open-eda-model -p open-eda-napi",
        "build:napi": "wae native build",
        "build:ts": "pnpm --filter @wae/open-eda run build",
        "build:ui": "pnpm --filter @wae/open-eda-ui run build",
        "build": "wae build",
        "stage:native": "wae native stage",
        "typecheck": "pnpm -r --filter \"./projects/packages/*\" run typecheck",
        "test": "pnpm -r --filter \"./projects/packages/*\" run test",
        "gui": "pnpm run build && pnpm --filter @wae/open-eda exec node ./dist/cli.js gui"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "@wae/wae": "0.0.6",
        "typescript": "^5.9.2"
    }
}
